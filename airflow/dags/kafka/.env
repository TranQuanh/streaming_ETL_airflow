# ==========================================
# Kafka consumer configuration
# ==========================================
BOOTSTRAP_SERVERS=kafka-1:9092,kafka-0:9092,kafka-2:9092
SECURITY_PROTOCOL=SASL_PLAINTEXT
SASL_MECHANISM=PLAIN
SASL_USERNAME=admin
SASL_PASSWORD=123
# GROUP_ID=behaviour   #load mongodb - 1 consumer
# GROUP_ID=behaviour_topic  #load consumer - 1 consumer
AUTO_OFFSET_RESET=earliest

# ==========================================
# Kafka producer configuration
# ==========================================
PRODUCER_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-0:9092,kafka-2:9092
PRODUCER_SECURITY_PROTOCOL=SASL_PLAINTEXT
PRODUCER_SASL_MECHANISM=PLAIN
PRODUCER_SASL_USERNAME=admin
PRODUCER_SASL_PASSWORD=123

# ==========================================
# MongoDB configuration
# ==========================================
# LƯU Ý: Nếu chạy script từ máy host (ngoài Docker) thì sửa "mongodb_BI" thành "localhost"
MONGO_URI=mongodb://admin:123@mongodb_BI:27017/?authSource=admin
MONGO_DB_NAME=glamira
MONGO_COLLECTION=summary